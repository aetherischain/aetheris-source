# /etc/conf.d/aetherisd: config file for /etc/init.d/aetherisd

# Config file location
#BLACKMORED_CONFIGFILE="/etc/aetheris/aetheris.conf"

# What directory to write pidfile to?  (created and owned by $BLACKMORED_USER)
#BLACKMORED_PIDDIR="/var/run/aetherisd"

# What filename to give the pidfile
#BLACKMORED_PIDFILE="${BLACKMORED_PIDDIR}/aetherisd.pid"

# Where to write aetherisd data (be mindful that the blockchain is large)
#BLACKMORED_DATADIR="/var/lib/aetherisd"

# User and group to own aetherisd process
#BLACKMORED_USER="aetheris"
#BLACKMORED_GROUP="aetheris"

# Path to aetherisd executable
#BLACKMORED_BIN="/usr/bin/aetherisd"

# Nice value to run aetherisd under
#BLACKMORED_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#BLACKMORED_OPTS=""

# The timeout in seconds OpenRC will wait for aetherisd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
BLACKMORED_SIGTERM_TIMEOUT=600
